# ==============================================================================
# myKairn SciWatch — Configuration Environnement
# ==============================================================================

# --- Stockage & Serveur Web (VM Freebox : 192.168.1.170) ---
SCIWATCH_DB_PATH=data/sciwatch.db
SCIWATCH_PROFILES_DIR=profiles
SCIWATCH_REPORTS_DIR=reports
SCIWATCH_HOST=0.0.0.0
SCIWATCH_PORT=8095

# --- APIs Scientifiques (Optionnelles : augmentent les quotas de requêtes) ---
NCBI_API_KEY=
NCBI_EMAIL=contact@mykairn.fr
OPENALEX_EMAIL=contact@mykairn.fr
SEMANTIC_SCHOLAR_API_KEY=

# --- Enrichissement IA / LLM (Optionnel — Moteur hybride déterministe actif par défaut) ---
# Providers supportés : gemini (défaut), openai, anthropic, none
SCIWATCH_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Notifications Digest Email (Optionnel — Brevo REST API v3 ou SMTP) ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=contact@mykairn.fr
BREVO_FROM_NAME=myKairn SciWatch
SCIWATCH_DIGEST_TO=reubrechtj@free.fr

# --- Pont / Webhook & Sécurité vers mykairn.fr (Cloudflare Tunnel) ---
SCIWATCH_API_SECRET=
SCIWATCH_ALLOW_LAN_DIRECT=true
SCIWATCH_TRUSTED_LAN_PREFIXES=192.168.,10.
SCIWATCH_CORS_ORIGIN=https://mykairn.fr
MYKAIRN_WEBHOOK_URL=https://mykairn.fr/api/sciwatch/webhook
MYKAIRN_WEBHOOK_SECRET=

# --- Déploiement VM Freebox Delta ---
FREEBOX_VM_HOST=192.168.1.170
FREEBOX_VM_USER=freebox
FREEBOX_VM_PASS=
FREEBOX_VM_DIR=/opt/mykairn-sciwatch
